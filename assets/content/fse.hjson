type: "HeatConductor"
name: "Small Heat Redirector"
description: "Redirects heat flows."
size: 2
group: "heat"

requirements: [
    "surge-alloy/8"
    "graphite/8"
]

category: "crafting"

drawer: {
    type: "DrawMulti"
    drawers: [
        {
            type: "DrawDefault"
        }
        {
            type: "DrawHeatOutput"
        }
        {
            type: "DrawHeatInput"
            suffix: "-heat"
        }
    ]
}